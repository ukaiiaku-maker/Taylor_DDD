+                         dot(f_before + f_after1, dx1)) * work_scale_J;
+                    const double tau_eff = candidate.trial_work_J /
+                                           p.barrier.vstar_m3;
+                    candidate.evaluation = Arrhenius::evaluate(
+                        tau_eff, p.temperature_K, system->realdt, p.barrier);
+                    const int split_id = splits(row_id,1);
+                    const std::uint64_t key = Arrhenius::event_key(
+                        tag.domain, tag.index, candidate.event_class, split_id);
+                    candidate.decision = residence_hazard.advance(
+                        key, system->simulation_step, system->realdt,
+                        candidate.evaluation.Rdt, p.high_hazard_Rdt, p.seed);
+
+                    if (candidate.decision.fired) {
+                        const double score = candidate.decision.deterministic_high_hazard ?
+                            candidate.evaluation.Rdt + 1.0e100 :
+                            candidate.decision.accumulated_after /
+                            candidate.decision.threshold;
+                        if (score > best_hazard_score) {
+                            best_hazard_score = score;
+                            kmax = split_id;
+                            p0 = smn->splitpos(row_id,0);
+                            p1 = smn->splitpos(row_id,1);
+                        }
+                    }
+                }
+
+                if (kmax >= 0) {
+                    for (int row_id = split_begin; row_id < isplit; ++row_id) {
+                        CandidateKinetics& candidate = kinetics[row_id];
+                        if (candidate.event_class < 0) continue;
+                        const int split_id = splits(row_id,1);
+                        const std::uint64_t key = Arrhenius::event_key(
+                            tag.domain, tag.index, candidate.event_class, split_id);
+                        if (split_id == kmax) arrhenius_selected[row_id] = 1;
+                        // The node connectivity changes after a split, so all
+                        // competing candidate residence states are invalidated.
+                        residence_hazard.discard(key);
+                    }
+                }
+            }
+
 #ifdef EXADIS_ENABLE_EVENT_AUDIT
             audit_split_candidates(isplit-nsplit, nsplit, nconn, kmax,
-                                   kmax >= 0 ? "accepted_max_power" :
+                                   stock_kmax >= 0 ? "accepted_max_power" :
                                                "rejected_stock_power_threshold");
