diff --git a/src/arrhenius/taylor_line_tension_interaction.h b/src/arrhenius/taylor_line_tension_interaction.h
new file mode 100644
index 0000000..47bb34d
--- /dev/null
+++ b/src/arrhenius/taylor_line_tension_interaction.h
@@ -0,0 +1,168 @@
+/*---------------------------------------------------------------------------
+ * Shared single-glider Taylor force-work kernel for D-D interactions.
+ *-------------------------------------------------------------------------*/
+
+#pragma once
+#ifndef EXADIS_ARRHENIUS_TAYLOR_LINE_TENSION_INTERACTION_H
+#define EXADIS_ARRHENIUS_TAYLOR_LINE_TENSION_INTERACTION_H
+
+#include "arrhenius/arrhenius_exp_floor.h"
+
+#include <cmath>
+#include <string>
+
+namespace ExaDiS {
+namespace Arrhenius {
+
+enum TaylorForceSource {
+    NATIVE_TRIAL_FORCE_PREFERRED = 0,
+    LINE_TENSION_RECONSTRUCTION = 1
+};
+
+struct TaylorInteractionParams {
+    double x_dagger_m = -1.0;
+    double line_tension_alpha = 0.5;
+    TaylorForceSource force_source = NATIVE_TRIAL_FORCE_PREFERRED;
+};
+
+struct TaylorInteractionInput {
+    int mechanism_id = -1;
+    int candidate_id = -1;
+    int node_id = -1;
+    int seg_id_a = -1;
+    int seg_id_b = -1;
+    int junction_id = -1;
+
+    double b_m = 0.0;
+    double mu_Pa = 0.0;
+    double alpha_line_tension = 0.5;
+
+    Vec3 event_direction;
+    Vec3 line_direction_a;
+    Vec3 line_direction_b;
+    Vec3 burgers_a;
+    Vec3 burgers_b;
+    Vec3 plane_normal;
+
+    double L_left_m = 0.0;
+    double L_right_m = 0.0;
+    double L_eff_m = 0.0;
+
+    double x_dagger_m = 0.0;
+    double vstar_m3 = 0.0;
+
+    Vec3 native_force_before_N;
+    Vec3 native_force_after_N;
+    Vec3 trial_displacement_m;
+    bool native_force_available = false;
+    bool native_projected_force_available = false;
+    double native_projected_force_N = 0.0;
+
+    double tau_app_resolved_Pa = 0.0;
+    double dt_s = 0.0;
+    double temperature_K = 0.0;
+};
+
+struct TaylorInteractionOutput {
+    double line_tension_N = 0.0;
+    double F_line_tension_N = 0.0;
+    double F_native_projected_N = 0.0;
+    double F_event_N = 0.0;
+
+    double native_trial_work_J = 0.0;
+    double work_bias_J = 0.0;
+    double tau_eff_Pa = 0.0;
+    double phi_eff = 0.0;
+    double phi_geom_L_over_b = 0.0;
+
+    double L_min_m = 0.0;
+    double L_harmonic_m = 0.0;
+    double L_sum_m = 0.0;
+    double L_eff_m = 0.0;
+
+    double G_eV = 0.0;
+    double G_floor_eV = 0.0;
+    double G_used_eV = 0.0;
+    double rate_s = 0.0;
+    double Rdt = 0.0;
+    double probability = 0.0;
+
+    TaylorForceSource force_source_used = NATIVE_TRIAL_FORCE_PREFERRED;
+};
+
+KOKKOS_INLINE_FUNCTION
+double harmonic_adjacent_arm_length(double left_m, double right_m)
+{
+    if (!(left_m > 0.0)) return right_m > 0.0 ? right_m : 0.0;
+    if (!(right_m > 0.0)) return left_m;
+    return 2.0 / (1.0 / left_m + 1.0 / right_m);
+}
+
+KOKKOS_INLINE_FUNCTION
+TaylorInteractionOutput evaluate_taylor_interaction(
+    const TaylorInteractionInput& input, const ExpFloorParams& barrier,
+    TaylorForceSource requested_source=NATIVE_TRIAL_FORCE_PREFERRED)
+{
+    TaylorInteractionOutput out;
+    const double left = input.L_left_m > 0.0 ? input.L_left_m : 0.0;
+    const double right = input.L_right_m > 0.0 ? input.L_right_m : 0.0;
+    out.L_min_m = left > 0.0 && right > 0.0 ?
+        (left < right ? left : right) : (left > right ? left : right);
+    out.L_harmonic_m = harmonic_adjacent_arm_length(left, right);
+    out.L_sum_m = left + right;
+    out.L_eff_m = input.L_eff_m > 0.0 ? input.L_eff_m : out.L_harmonic_m;
+
+    Vec3 q = input.event_direction;
+    if (q.norm2() > 0.0) q = q.normalized();
+    Vec3 ta = input.line_direction_a;
+    Vec3 tb = input.line_direction_b;
+    if (ta.norm2() > 0.0) ta = ta.normalized();
+    if (tb.norm2() > 0.0) tb = tb.normalized();
+
+    out.line_tension_N = input.alpha_line_tension * input.mu_Pa *
+                         input.b_m * input.b_m;
+    out.F_line_tension_N = out.line_tension_N * dot(ta + tb, q);
+
+    const Vec3 mean_native = 0.5 *
+        (input.native_force_before_N + input.native_force_after_N);
+    out.F_native_projected_N = input.native_projected_force_available ?
+        input.native_projected_force_N : dot(mean_native, q);
+    out.native_trial_work_J = dot(mean_native, input.trial_displacement_m);
+
+    const bool use_native = requested_source == NATIVE_TRIAL_FORCE_PREFERRED &&
+        (input.native_projected_force_available || input.native_force_available);
+    out.force_source_used = use_native ? NATIVE_TRIAL_FORCE_PREFERRED :
+                                         LINE_TENSION_RECONSTRUCTION;
+    out.F_event_N = use_native ? out.F_native_projected_N :
+                                out.F_line_tension_N;
+
+    // This is the only mechanical amplification entering the barrier. L_eff/b
+    // is deliberately diagnostic and is never multiplied into force work.
+    out.work_bias_J = out.F_event_N * input.x_dagger_m;
+    out.tau_eff_Pa = input.vstar_m3 > 0.0 ?
+        out.work_bias_J / input.vstar_m3 : 0.0;
+    out.phi_eff = std::fabs(input.tau_app_resolved_Pa) > 1.0e-30 ?
+        out.tau_eff_Pa / input.tau_app_resolved_Pa : 0.0;
+    out.phi_geom_L_over_b = input.b_m > 0.0 ?
+        out.L_eff_m / input.b_m : 0.0;
+
+    const Evaluation eval = evaluate(
+        out.tau_eff_Pa, input.temperature_K, input.dt_s, barrier);
+    out.G_eV = eval.G_eV;
+    out.G_floor_eV = eval.G_floor_eV;
+    out.G_used_eV = eval.G_used_eV;
+    out.rate_s = eval.rate_s;
+    out.Rdt = eval.Rdt;
+    out.probability = eval.probability;
+    return out;
+}
+
+const char* taylor_force_source_name(TaylorForceSource source);
+void validate_taylor_interaction(const TaylorInteractionParams& params,
+                                 const ExpFloorParams& barrier,
+                                 const std::string& mechanism);
+
+} // namespace Arrhenius
