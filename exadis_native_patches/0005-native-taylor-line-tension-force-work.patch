+            input.x_dagger_m = x_dagger_b * b_m;
+            input.vstar_m3 = barrier.vstar_m3;
+            input.native_projected_force_available = true;
+            input.native_projected_force_N = F_event_N;
+            input.tau_app_resolved_Pa = tau_app_resolved_Pa;
+            input.dt_s = dt_s;
+            input.temperature_K = temperature_K;
+            const auto out = Arrhenius::evaluate_taylor_interaction(
+                input, barrier, Arrhenius::NATIVE_TRIAL_FORCE_PREFERRED);
+            py::dict result;
+            result["line_tension_N"] = out.line_tension_N;
+            result["F_line_tension_N"] = out.F_line_tension_N;
+            result["F_event_N"] = out.F_event_N;
+            result["work_bias_J"] = out.work_bias_J;
+            result["tau_eff_Pa"] = out.tau_eff_Pa;
