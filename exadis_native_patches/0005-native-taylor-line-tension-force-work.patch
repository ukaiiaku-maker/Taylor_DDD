+            result["phi_geom_L_over_b"] = out.phi_geom_L_over_b;
+            result["L_eff_m"] = out.L_eff_m;
+            result["G_eV"] = out.G_eV;
+            result["G_floor_eV"] = out.G_floor_eV;
+            result["G_used_eV"] = out.G_used_eV;
+            result["rate_s"] = out.rate_s;
+            result["Rdt"] = out.Rdt;
+            result["P"] = out.probability;
+            return result;
+        },
+        py::arg("F_event_N"), py::arg("L_left_m"), py::arg("L_right_m"),
