+namespace ExaDiS {
+namespace Arrhenius {
+
+const char* taylor_force_source_name(TaylorForceSource source)
+{
+    switch (source) {
+    case NATIVE_TRIAL_FORCE_PREFERRED: return "native_trial";
+    case LINE_TENSION_RECONSTRUCTION: return "line_tension_reconstruction";
+    default: return "unknown";
+    }
+}
+
+void validate_taylor_interaction(const TaylorInteractionParams& params,
+                                 const ExpFloorParams& barrier,
+                                 const std::string& mechanism)
+{
+    std::ostringstream errors;
+    if (!(std::isfinite(params.x_dagger_m) && params.x_dagger_m > 0.0))
+        errors << " x_dagger_m";
+    if (!(std::isfinite(params.line_tension_alpha) &&
+          params.line_tension_alpha > 0.0))
+        errors << " line_tension_alpha";
+    if (!errors.str().empty())
+        throw std::invalid_argument(
+            "invalid Taylor interaction parameters for " + mechanism + ":" +
+            errors.str());
+}
