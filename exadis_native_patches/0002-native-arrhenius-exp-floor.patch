diff --git a/src/arrhenius/arrhenius_exp_floor.cpp b/src/arrhenius/arrhenius_exp_floor.cpp
new file mode 100644
index 0000000..6535f79
--- /dev/null
+++ b/src/arrhenius/arrhenius_exp_floor.cpp
@@ -0,0 +1,30 @@
+#include "arrhenius/arrhenius_exp_floor.h"
+
+#include <sstream>
+#include <stdexcept>
+
+namespace ExaDiS {
+namespace Arrhenius {
+
+void validate(const ExpFloorParams& p, double temperature_K,
+              const std::string& mechanism)
+{
+    std::ostringstream errors;
+    if (!(std::isfinite(temperature_K) && temperature_K > 0.0)) errors << " temperature_K";
+    if (!(std::isfinite(p.H_eV) && p.H_eV > 0.0)) errors << " H_eV";
+    if (!std::isfinite(p.S_kB)) errors << " S_kB";
+    if (!(std::isfinite(p.sigma_c_Pa) && p.sigma_c_Pa > 0.0)) errors << " sigma_c";
+    if (!(std::isfinite(p.floor_fraction) && p.floor_fraction >= 0.0 &&
+          p.floor_fraction <= 1.0)) errors << " f";
+    if (!(std::isfinite(p.shape_a) && p.shape_a > 0.0)) errors << " a";
+    if (!(std::isfinite(p.shape_n) && p.shape_n > 0.0)) errors << " n";
+    if (!(std::isfinite(p.eta0_s) && p.eta0_s > 0.0)) errors << " eta0_s";
+    if (!(std::isfinite(p.vstar_m3) && p.vstar_m3 > 0.0)) errors << " vstar";
+    if (!errors.str().empty()) {
+        throw std::invalid_argument(
+            "invalid or missing " + mechanism + " EXP-floor parameter(s):" + errors.str());
+    }
+}
+
+} // namespace Arrhenius
+} // namespace ExaDiS
diff --git a/src/arrhenius/arrhenius_exp_floor.h b/src/arrhenius/arrhenius_exp_floor.h
new file mode 100644
index 0000000..b9a50a0
--- /dev/null
+++ b/src/arrhenius/arrhenius_exp_floor.h
@@ -0,0 +1,137 @@
+/*---------------------------------------------------------------------------
+ * Native transition-state-theory EXP-floor hazard shared by ExaDiS modules.
+ *-------------------------------------------------------------------------*/
+
+#pragma once
+#ifndef EXADIS_ARRHENIUS_EXP_FLOOR_H
+#define EXADIS_ARRHENIUS_EXP_FLOOR_H
+
+#include "types.h"
+
+#include <cmath>
+#include <string>
+
+namespace ExaDiS {
+namespace Arrhenius {
+
+constexpr double KB_EV_K = 8.617333262145e-5;
+constexpr double EV_J = 1.602176634e-19;
+constexpr double DEFAULT_ETA0_S = 1.0e12;
+
+struct ExpFloorParams {
+    double H_eV = -1.0;
+    double S_kB = 0.0;
+    double sigma_c_Pa = -1.0;
+    double floor_fraction = -1.0;
+    double shape_a = -1.0;
+    double shape_n = -1.0;
+    double eta0_s = DEFAULT_ETA0_S;
+    double vstar_m3 = -1.0;
+};
+
+struct StressCoupling {
+    double a_nn = 0.0;
+    double a_mm = 0.0;
+    double a_np = 0.0;
+    double a_other = 0.0;
+};
+
+struct StressComponents {
+    double tau_s_Pa = 0.0;
+    double sigma_nn_Pa = 0.0;
+    double sigma_mm_Pa = 0.0;
+    double sigma_np_Pa = 0.0;
+    double sigma_other_Pa = 0.0;
+};
+
+struct Evaluation {
+    double tau_eff_Pa = 0.0;
+    double activation_work_J = 0.0;
+    double G_eV = 0.0;
+    double G_floor_eV = 0.0;
+    double G_used_eV = 0.0;
+    double rate_s = 0.0;
+    double Rdt = 0.0;
+    double probability = 0.0;
+};
+
+KOKKOS_INLINE_FUNCTION
+double effective_stress_Pa(const StressComponents& stress,
+                           const StressCoupling& coupling)
+{
+    return stress.tau_s_Pa +
+           coupling.a_nn * stress.sigma_nn_Pa +
+           coupling.a_mm * stress.sigma_mm_Pa +
+           coupling.a_np * stress.sigma_np_Pa +
+           coupling.a_other * stress.sigma_other_Pa;
+}
+
+KOKKOS_INLINE_FUNCTION
+double tensor_activation_work_J(const Mat33& sigma_Pa,
+                                const Mat33& activation_tensor_m3)
+{
+    return dot(sigma_Pa, activation_tensor_m3);
+}
+
+KOKKOS_INLINE_FUNCTION
+double tensor_effective_stress_Pa(const Mat33& sigma_Pa,
+                                  const Mat33& activation_tensor_m3,
+                                  double vstar_m3)
+{
+    return tensor_activation_work_J(sigma_Pa, activation_tensor_m3) / vstar_m3;
+}
+
+KOKKOS_INLINE_FUNCTION
+Evaluation evaluate(double tau_eff_Pa, double temperature_K, double dt_s,
+                    const ExpFloorParams& params)
+{
+    Evaluation out;
+    out.tau_eff_Pa = tau_eff_Pa;
+    out.activation_work_J = tau_eff_Pa * params.vstar_m3;
+
+    const double drive = tau_eff_Pa > 0.0 ? tau_eff_Pa : 0.0;
+    const double ratio = drive / params.sigma_c_Pa;
+    const double shaped = params.H_eV *
+        (params.floor_fraction + (1.0 - params.floor_fraction) *
+         exp(-params.shape_a * pow(ratio, params.shape_n)));
+    out.G_eV = shaped - KB_EV_K * temperature_K * params.S_kB;
+    out.G_floor_eV = params.floor_fraction * params.H_eV -
+                     KB_EV_K * temperature_K * params.S_kB;
+    const double floor_nonnegative = out.G_floor_eV > 0.0 ? out.G_floor_eV : 0.0;
+    out.G_used_eV = out.G_eV > floor_nonnegative ? out.G_eV : floor_nonnegative;
+    out.rate_s = params.eta0_s * exp(-out.G_used_eV / (KB_EV_K * temperature_K));
+    out.Rdt = out.rate_s * (dt_s > 0.0 ? dt_s : 0.0);
+    out.probability = -expm1(-out.Rdt);
+    return out;
+}
+
+KOKKOS_INLINE_FUNCTION
+Evaluation evaluate_tensor(const Mat33& sigma_Pa,
+                           const Mat33& activation_tensor_m3,
+                           double temperature_K, double dt_s,
+                           const ExpFloorParams& params)
+{
+    Evaluation out = evaluate(
+        tensor_effective_stress_Pa(
+            sigma_Pa, activation_tensor_m3, params.vstar_m3),
+        temperature_K, dt_s, params);
+    out.activation_work_J = tensor_activation_work_J(
+        sigma_Pa, activation_tensor_m3);
+    return out;
+}
+
+KOKKOS_INLINE_FUNCTION
+double signed_rate_s(double tau_eff_Pa, double temperature_K,
+                     const ExpFloorParams& params)
+{
+    return evaluate(tau_eff_Pa, temperature_K, 0.0, params).rate_s -
+           evaluate(-tau_eff_Pa, temperature_K, 0.0, params).rate_s;
+}
+
+void validate(const ExpFloorParams& params, double temperature_K,
+              const std::string& mechanism);
+
+} // namespace Arrhenius
+} // namespace ExaDiS
+
+#endif
