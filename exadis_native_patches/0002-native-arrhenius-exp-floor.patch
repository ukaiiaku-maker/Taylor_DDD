diff --git a/src/mobility_types/mobility_fcc0_arrhenius.h b/src/mobility_types/mobility_fcc0_arrhenius.h
new file mode 100644
index 0000000..9c8011f
--- /dev/null
+++ b/src/mobility_types/mobility_fcc0_arrhenius.h
@@ -0,0 +1,362 @@
+/*---------------------------------------------------------------------------
+ * Native FCC mobility driven by directional EXP-floor TST hazards.
+ *-------------------------------------------------------------------------*/
+
+#pragma once
+#ifndef EXADIS_MOBILITY_FCC0_ARRHENIUS_H
+#define EXADIS_MOBILITY_FCC0_ARRHENIUS_H
+
+#include "arrhenius/arrhenius_exp_floor.h"
+#include "mobility.h"
+
+#include <string>
+
+namespace ExaDiS {
+
+struct MobilityFCC0Arrhenius
+{
+    bool non_linear = true;
+    int mode = 1; // 1: peierls, 2: character-dependent full surrogate
+    double temperature_K = -1.0;
+    double jump_b = -1.0;
+    double vmax = -1.0;
+    Arrhenius::ExpFloorParams peierls;
+    Arrhenius::ExpFloorParams screw;
+    Arrhenius::StressCoupling coupling;
+
+    struct Params {
+        std::string mode = "peierls";
+        double temperature_K = -1.0;
+        double H_eV = -1.0;
+        double S_kB = 0.0;
+        double sigma_c_GPa = -1.0;
+        double f = -1.0;
+        double a = -1.0;
+        double n = -1.0;
+        double eta0_s = Arrhenius::DEFAULT_ETA0_S;
+        double vstar_b3 = -1.0;
+        double jump_b = -1.0;
+        double H_screw_eV = -1.0;
+        double sigma_c_screw_GPa = -1.0;
+        double vstar_screw_b3 = -1.0;
+        double a_nn = 0.0;
+        double a_mm = 0.0;
+        double a_np = 0.0;
+        double a_other = 0.0;
+        double vmax = -1.0;
+
+        Params() = default;
+        Params(Dict paramslist) {
+            for (auto const& [key, val] : paramslist) {
+                const std::string name = dict::get_key(key);
+                if      (name == "mode") mode = dict::get_val<std::string>(val);
+                else if (name == "temperature_K") temperature_K = dict::get_val<double>(val);
+                else if (name == "H_eV") H_eV = dict::get_val<double>(val);
+                else if (name == "S_kB") S_kB = dict::get_val<double>(val);
+                else if (name == "sigma_c_GPa") sigma_c_GPa = dict::get_val<double>(val);
+                else if (name == "f") f = dict::get_val<double>(val);
+                else if (name == "a") a = dict::get_val<double>(val);
+                else if (name == "n") n = dict::get_val<double>(val);
+                else if (name == "eta0_s") eta0_s = dict::get_val<double>(val);
+                else if (name == "vstar_b3") vstar_b3 = dict::get_val<double>(val);
+                else if (name == "jump_b") jump_b = dict::get_val<double>(val);
+                else if (name == "H_screw_eV") H_screw_eV = dict::get_val<double>(val);
+                else if (name == "sigma_c_screw_GPa") sigma_c_screw_GPa = dict::get_val<double>(val);
+                else if (name == "vstar_screw_b3") vstar_screw_b3 = dict::get_val<double>(val);
+                else if (name == "a_nn") a_nn = dict::get_val<double>(val);
+                else if (name == "a_mm") a_mm = dict::get_val<double>(val);
+                else if (name == "a_np") a_np = dict::get_val<double>(val);
+                else if (name == "a_other") a_other = dict::get_val<double>(val);
+                else if (name == "vmax") vmax = dict::get_val<double>(val);
+                else ExaDiS_fatal("Error: unknown MobilityFCC0Arrhenius input parameter %s\n", name.c_str());
+            }
+        }
+    };
+
+    struct NodeDiagnostics {
+        double tau_force_Pa = 0.0;
+        double tau_eff_Pa = 0.0;
+        double character_screw_abs = 0.0;
+        double half_length_internal = 0.0;
+        Vec3 direction;
+        Vec3 slip;
+        Vec3 plane;
+        Vec3 transverse;
+        Arrhenius::ExpFloorParams params;
+        Arrhenius::Evaluation forward;
+        Arrhenius::Evaluation reverse;
+    };
+
+    MobilityFCC0Arrhenius(System* system, Params& p)
+    {
+        if (system->crystal.type != FCC_CRYSTAL)
+            ExaDiS_fatal("Error: MobilityFCC0Arrhenius must be used with FCC crystal type\n");
+        if (!system->crystal.use_glide_planes)
+            ExaDiS_fatal("Error: MobilityFCC0Arrhenius requires glide planes\n");
+        if (p.mode == "peierls") mode = 1;
+        else if (p.mode == "full") mode = 2;
+        else ExaDiS_fatal("Error: MobilityFCC0Arrhenius mode must be peierls or full\n");
+
+        const double b3 = system->params.burgmag * system->params.burgmag *
+                          system->params.burgmag;
+        temperature_K = p.temperature_K;
+        jump_b = p.jump_b;
+        vmax = p.vmax;
+        peierls.H_eV = p.H_eV;
+        peierls.S_kB = p.S_kB;
+        peierls.sigma_c_Pa = p.sigma_c_GPa * 1.0e9;
+        peierls.floor_fraction = p.f;
+        peierls.shape_a = p.a;
+        peierls.shape_n = p.n;
+        peierls.eta0_s = p.eta0_s;
+        peierls.vstar_m3 = p.vstar_b3 * b3;
+        screw = peierls;
+        if (mode == 2) {
+            screw.H_eV = p.H_screw_eV;
+            screw.sigma_c_Pa = p.sigma_c_screw_GPa * 1.0e9;
+            screw.vstar_m3 = p.vstar_screw_b3 * b3;
+        }
+        coupling.a_nn = p.a_nn;
+        coupling.a_mm = p.a_mm;
+        coupling.a_np = p.a_np;
+        coupling.a_other = p.a_other;
+
+        try {
+            Arrhenius::validate(peierls, temperature_K, "FCC Peierls");
+            if (mode == 2) Arrhenius::validate(screw, temperature_K, "FCC screw Peierls");
+        } catch (const std::exception& error) {
+            ExaDiS_fatal("Error: %s\n", error.what());
+        }
+        if (!(std::isfinite(jump_b) && jump_b > 0.0))
+            ExaDiS_fatal("Error: invalid or missing FCC Arrhenius jump_b\n");
+        if (!std::isfinite(vmax))
+            ExaDiS_fatal("Error: invalid FCC Arrhenius vmax\n");
+        if (!(std::isfinite(coupling.a_nn) && std::isfinite(coupling.a_mm) &&
+              std::isfinite(coupling.a_np) && std::isfinite(coupling.a_other)))
+            ExaDiS_fatal("Error: invalid FCC Arrhenius anisotropic coupling\n");
+    }
+
+    KOKKOS_INLINE_FUNCTION
+    Arrhenius::ExpFloorParams character_params(double screw_fraction) const
+    {
+        if (mode != 2) return peierls;
+        Arrhenius::ExpFloorParams p = peierls;
+        p.H_eV += screw_fraction * (screw.H_eV - peierls.H_eV);
+        p.sigma_c_Pa += screw_fraction * (screw.sigma_c_Pa - peierls.sigma_c_Pa);
+        p.vstar_m3 += screw_fraction * (screw.vstar_m3 - peierls.vstar_m3);
+        return p;
+    }
+
+    template<class N>
+    KOKKOS_INLINE_FUNCTION
+    Vec3 node_velocity_impl(System* system, N* net, const int& i, const Vec3& fi,
+                            NodeDiagnostics* diagnostic) const
+    {
+        auto nodes = net->get_nodes();
+        auto segs = net->get_segs();
+        auto conn = net->get_conn();
+        const Cell cell = net->cell;
+        Vec3 vi(0.0);
+        const int nconn = conn[i].num;
+        if (nconn < 2 || nodes[i].constraint == PINNED_NODE) return vi;
+
+        const double eps = 1.0e-10;
+        Vec3 normals[3], line_constraint;
+        int ngc = 0, nlc = 0, nonzero = 0;
+        Mat33 P = Mat33().eye();
+        double total_length = 0.0;
+        double screw_weight = 0.0;
+        Vec3 msum(0.0), nsum(0.0), psum(0.0);
+        const Vec3 r1 = nodes[i].pos;
+
+        for (int j = 0; j < nconn; ++j) {
+            const int k = conn[i].node[j];
+            Vec3 dr = cell.pbc_position(r1, nodes[k].pos) - r1;
+            const double L = dr.norm();
+            if (L < eps) continue;
+            dr = (1.0 / L) * dr;
+            ++nonzero;
+            total_length += L;
+
+            const int s = conn[i].seg[j];
+            const Vec3 burg = conn[i].order[j] * segs[s].burg;
+            const double bmag = burg.norm();
+            const Vec3 m = bmag > eps ? (1.0 / bmag) * burg : Vec3(0.0);
+            const double character = bmag > eps ? fabs(dot(m, dr)) : 0.0;
+            screw_weight += L * character;
+
+            Vec3 plane = segs[s].plane.normalized();
+            Vec3 transverse = cross(plane, m);
+            if (transverse.norm2() > eps) transverse = transverse.normalized();
+            msum += L * m;
+            nsum += L * plane;
+            psum += L * transverse;
+
+            const Vec3 crystal_plane = system->crystal.Rinv * plane;
+            Vec3 line(0.0);
+            if ((fabs(fabs(crystal_plane.x) - fabs(crystal_plane.y)) > 1e-4) ||
+                (fabs(fabs(crystal_plane.y) - fabs(crystal_plane.z)) > 1e-4))
+                line = dr;
+            if (ngc < 3) {
+                for (int q = 0; q < ngc; ++q) plane = plane.orthogonalize(normals[q]);
+                if (plane.norm2() >= 0.05) {
+                    plane = plane.normalized();
+                    P = (Mat33().eye() - outer(plane, plane)) * P;
+                    normals[ngc++] = plane;
+                }
+            }
+            if (nlc < 2) {
+                if (nlc == 1) line = line.orthogonalize(line_constraint);
+                if (line.norm2() >= 0.05) {
+                    line_constraint = line.normalized();
+                    ++nlc;
+                }
+            }
+        }
+        if (nonzero == 0 || total_length <= 0.0) return vi;
+        if (nlc == 1) {
+            P = outer(line_constraint, line_constraint) * P;
+            for (int q = 0; q < ngc; ++q)
+                if (fabs(dot(normals[q], line_constraint)) > 0.05) P.zero();
+        } else if (nlc >= 2) {
+            P.zero();
+        }
+        for (int q = 0; q < 3; ++q)
+            for (int r = 0; r < 3; ++r)
+                if (fabs(P[q][r]) < 1e-10) P[q][r] = 0.0;
+
+        const Vec3 drive = P * fi;
+        const double drive_norm = drive.norm();
+        if (drive_norm <= eps) return vi;
+        const Vec3 direction = (1.0 / drive_norm) * drive;
+        const double half_length = 0.5 * total_length;
+        const double tau_force = drive_norm / half_length;
+        const double screw_fraction = screw_weight / total_length;
+
+        Vec3 m = msum.norm2() > eps ? msum.normalized() : Vec3(0.0);
+        Vec3 n = nsum.norm2() > eps ? nsum.normalized() : Vec3(0.0);
+        Vec3 transverse = psum.norm2() > eps ? psum.normalized() : Vec3(0.0);
+        Arrhenius::StressComponents components;
+        components.tau_s_Pa = tau_force;
+        components.sigma_nn_Pa = dot(n, system->extstress * n);
+        components.sigma_mm_Pa = dot(m, system->extstress * m);
+        components.sigma_np_Pa = dot(n, system->extstress * transverse);
+        const double tau_eff = Arrhenius::effective_stress_Pa(components, coupling);
+        const Arrhenius::ExpFloorParams hp = character_params(screw_fraction);
+        const Arrhenius::Evaluation forward =
+            Arrhenius::evaluate(tau_eff, temperature_K, system->realdt, hp);
+        const Arrhenius::Evaluation reverse =
+            Arrhenius::evaluate(-tau_eff, temperature_K, system->realdt, hp);
+        const double speed_internal = jump_b * (forward.rate_s - reverse.rate_s);
+        vi = speed_internal * direction;
+        if (vmax > 0.0) apply_velocity_cap(vmax, system->params.burgmag, vi);
+
+        if (diagnostic) {
+            diagnostic->tau_force_Pa = tau_force;
+            diagnostic->tau_eff_Pa = tau_eff;
+            diagnostic->character_screw_abs = screw_fraction;
+            diagnostic->half_length_internal = half_length;
+            diagnostic->direction = direction;
+            diagnostic->slip = m;
+            diagnostic->plane = n;
+            diagnostic->transverse = transverse;
+            diagnostic->params = hp;
+            diagnostic->forward = forward;
+            diagnostic->reverse = reverse;
+        }
+        return vi;
+    }
+
+    template<class N>
+    KOKKOS_INLINE_FUNCTION
+    Vec3 node_velocity(System* system, N* net, const int& i, const Vec3& fi)
+    {
+        return node_velocity_impl(system, net, i, fi, nullptr);
+    }
+
+    static constexpr const char* name = "MobilityFCC0Arrhenius";
+};
+
+#ifdef EXADIS_ENABLE_EVENT_AUDIT
+inline void audit_mobility(System* system, MobilityFCC0Arrhenius* mob)
+{
+    EventAuditRecorder* audit = system->event_audit;
+    if (!audit || !audit->claim_mobility_snapshot()) return;
+    SerialDisNet* net = system->get_serial_network();
+    const double b_m = system->params.burgmag;
+    const double b3 = b_m * b_m * b_m;
+    for (int i = 0; i < net->number_of_nodes(); ++i) {
+        MobilityFCC0Arrhenius::NodeDiagnostics d;
+        const Vec3 fi = net->nodes[i].f;
+        const Vec3 vi = mob->node_velocity_impl(system, net, i, fi, &d);
+        if (d.half_length_internal <= 0.0) continue;
+        const Arrhenius::Evaluation evals[2] = {d.forward, d.reverse};
+        const char* classes[2] = {"peierls_forward", "peierls_reverse"};
+        for (int direction = 0; direction < 2; ++direction) {
+            EventAuditRecord row;
+            row.step = audit->step();
+            row.time_s = audit->time_s();
+            row.dt_s = system->realdt;
+            row.mechanism = "mobility_fcc0_arrhenius";
+            row.stage = "mobility";
+            row.event_class = classes[direction];
+            row.candidate_id = 2 * i + direction;
+            row.node_id = i;
+            row.L_m = 2.0 * d.half_length_internal * b_m;
+            row.character_screw_abs = d.character_screw_abs;
+            row.force_N[0] = fi.x * b_m * b_m;
+            row.force_N[1] = fi.y * b_m * b_m;
+            row.force_N[2] = fi.z * b_m * b_m;
+            row.velocity_m_s[0] = vi.x * b_m;
+            row.velocity_m_s[1] = vi.y * b_m;
+            row.velocity_m_s[2] = vi.z * b_m;
+            row.tau_local_Pa = d.tau_force_Pa;
+            row.tau_eff_Pa = evals[direction].tau_eff_Pa;
+            row.temperature_K = mob->temperature_K;
+            row.H_eV = d.params.H_eV;
+            row.S_kB = d.params.S_kB;
+            row.sigma_c_GPa = d.params.sigma_c_Pa / 1.0e9;
+            row.floor_fraction_f = d.params.floor_fraction;
+            row.shape_a = d.params.shape_a;
+            row.shape_n = d.params.shape_n;
+            row.eta0_s = d.params.eta0_s;
+            row.v_star_m3 = d.params.vstar_m3;
+            row.activation_work_J = evals[direction].activation_work_J;
+            row.G_eV = evals[direction].G_eV;
+            row.G_floor_eV = evals[direction].G_floor_eV;
+            row.G_used_eV = evals[direction].G_used_eV;
+            row.R_s = evals[direction].rate_s;
+            row.Rdt = evals[direction].Rdt;
+            row.probability = evals[direction].probability;
+            row.selection_threshold = -1.0;
+            row.accepted_arrhenius = -1;
+            const double sign = direction == 0 ? 1.0 : -1.0;
+            const Mat33 A = d.params.vstar_m3 *
+                (0.5 * sign * (outer(d.slip, d.plane) + outer(d.plane, d.slip)) +
+                 mob->coupling.a_nn * outer(d.plane, d.plane) +
+                 mob->coupling.a_mm * outer(d.slip, d.slip) +
+                 0.5 * mob->coupling.a_np *
+                    (outer(d.plane, d.transverse) + outer(d.transverse, d.plane)));
+            row.activation_tensor_m3[0] = A.xx();
+            row.activation_tensor_m3[1] = A.yy();
+            row.activation_tensor_m3[2] = A.zz();
+            row.activation_tensor_m3[3] = A.yz();
+            row.activation_tensor_m3[4] = A.xz();
+            row.activation_tensor_m3[5] = A.xy();
+            row.note = "directional_EXP_floor_mean_rate;no_Bernoulli_draw;"
+                       "tau_force=norm(PF)/(half_total_line_length);W=sigma:A_audited";
+            audit->write(row, system);
+        }
+    }
+}
+#endif
